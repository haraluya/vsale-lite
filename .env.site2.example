# ================================================
# 站點二環境變數範例
# ================================================
# 複製此檔案並在 .env.local 中新增以下設定

# 站點二 Supabase 配置
NEXT_PUBLIC_SUPABASE_URL_SITE2=https://your-site2-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY_SITE2=your-service-role-key-here

# 範例（請替換為實際值）:
# NEXT_PUBLIC_SUPABASE_URL_SITE2=https://rdyvmgomjdglflrcfijs.supabase.co
# SUPABASE_SERVICE_ROLE_KEY_SITE2=eyJhbGci...

# 如何取得：
# 1. 前往 Supabase Dashboard
# 2. Settings → API
# 3. 複製 URL 和 service_role key（非 anon key）
