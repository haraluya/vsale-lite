# ================================================
# Vsale-lite 環境變數範本
# ================================================
# 說明：複製此檔案為 .env.local 並填入實際值
# 最後更新：2026-01-23
# ================================================

# ================================================
# 1. 主要 Supabase 配置（必填）
# ================================================

# Supabase 專案 URL（必填）
# 如何取得：
# 1. 前往 https://supabase.com/dashboard
# 2. 選擇您的專案
# 3. Settings → API → Project URL
# 格式範例：https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase 公開金鑰（必填）
# 如何取得：
# 1. 前往 https://supabase.com/dashboard
# 2. 選擇您的專案
# 3. Settings → API → Project API keys → anon public
# 注意：這是公開金鑰，可以在前端使用
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase 服務金鑰（必填）
# 如何取得：
# 1. 前往 https://supabase.com/dashboard
# 2. 選擇您的專案
# 3. Settings → API → Project API keys → service_role secret
# ⚠️  警告：這是敏感金鑰，擁有完整資料庫權限，切勿公開或 commit 到 Git
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ================================================
# 2. 資料庫直連設定（可選，用於備份腳本）
# ================================================

# 資料庫主機位址（可選）
# 如何取得：
# 1. 前往 https://supabase.com/dashboard
# 2. 選擇您的專案
# 3. Settings → Database → Connection string → Host
# 格式範例：db.abcdefghijklmnopqrst.supabase.co
# DB_HOST=db.YOUR_PROJECT_REF.supabase.co

# 資料庫密碼（可選）
# 如何取得：
# 1. 前往 https://supabase.com/dashboard
# 2. 選擇您的專案
# 3. Settings → Database → Database password
# 注意：如果忘記密碼，需要重設
# ⚠️  警告：這是敏感資訊，切勿 commit 到 Git
# DB_PASSWORD=your_database_password

# 資料庫使用者名稱（可選，通常為 postgres）
# DB_USER=postgres

# 資料庫連接埠（可選，通常為 5432）
# DB_PORT=5432

# ================================================
# 3. Google Cloud Storage 備份設定（可選）
# ================================================

# GCS 儲存桶名稱（可選，用於雲端備份）
# 如何取得：
# 1. 前往 https://console.cloud.google.com/storage
# 2. 建立或選擇現有的儲存桶
# 格式範例：your-project-backups
# GCS_BUCKET_NAME=your-bucket-name

# GCS 服務帳號金鑰檔案路徑（可選）
# 如何取得：
# 1. 前往 https://console.cloud.google.com/iam-admin/serviceaccounts
# 2. 建立服務帳號並下載 JSON 金鑰檔案
# 3. 將檔案放在專案根目錄（已被 .gitignore 排除）
# 格式範例：./service-account-key.json
# ⚠️  警告：金鑰檔案包含敏感資訊，確保在 .gitignore 中被排除
# GCS_SERVICE_ACCOUNT_KEY=./service-account-key.json

# ================================================
# 4. 站點二配置（可選，用於多站點資料遷移）
# ================================================

# 站點二 Supabase URL（可選）
# 用途：在 site2:migrate 腳本中使用，將主站資料複製到站點二
# 格式範例：https://xyzabcdefghijklmnop.supabase.co
# NEXT_PUBLIC_SUPABASE_URL_SITE2=https://YOUR_SITE2_PROJECT_REF.supabase.co

# 站點二服務金鑰（可選）
# 用途：站點二的完整資料庫存取權限
# ⚠️  警告：這是敏感金鑰，切勿公開或 commit 到 Git
# SUPABASE_SERVICE_ROLE_KEY_SITE2=your_site2_service_role_key_here

# 站點二資料庫密碼（可選，用於 PowerShell 遷移腳本）
# 用途：import-data.ps1 使用的資料庫密碼
# ⚠️  警告：這是敏感資訊，切勿 commit 到 Git
# DB_PASSWORD_SITE2=your_site2_database_password

# ================================================
# 驗證環境變數
# ================================================
# 完成設定後，執行以下指令驗證環境變數是否正確：
#   pnpm check-env
#
# 如遇到問題，請參考：
#   docs/ENV_VARIABLES_CHECKLIST.md
#   docs/NEW_DEPLOYMENT_GUIDE.md
# ================================================
