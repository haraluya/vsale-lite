#!/bin/sh
# Git Pre-commit Hook - 資料庫安全檢查
# 檢測 Migration 檔案中的危險操作

# 顏色定義
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "🔍 執行資料庫安全檢查..."

# 檢查 1: Migration 檔案中的危險操作（排除 rollback 資料夾）
if git diff --cached --name-only | grep -q "supabase/migrations/.*\.sql$" | grep -v "rollback/"; then
  echo "⚠️ 檢測到 Migration 檔案變更，執行安全檢查..."

  # 檢查 DROP TABLE（排除註釋與 rollback 資料夾）
  if git diff --cached --name-status | grep -E "^[AM].*supabase/migrations/.*\.sql$" | grep -v "rollback/" | cut -f2 | while read file; do
    git diff --cached "$file" | grep -E "^\+.*DROP TABLE" | grep -v "^.*--.*DROP TABLE" && echo "$file"
  done | grep -q .; then
    echo -e "${RED}🚨 警告: 檢測到 DROP TABLE 指令！${NC}"
    echo "這是危險操作，可能導致資料遺失。"
    echo "📖 參考: docs/SAFE_MIGRATION_GUIDE.md (危險操作與替代方案)"
    echo ""
    read -p "確定要繼續提交嗎？(y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo -e "${YELLOW}⏸️ 已取消提交${NC}"
      exit 1
    fi
  fi

  # 檢查 TRUNCATE（排除註釋與 rollback 資料夾）
  if git diff --cached --name-status | grep -E "^[AM].*supabase/migrations/.*\.sql$" | grep -v "rollback/" | cut -f2 | while read file; do
    git diff --cached "$file" | grep -E "^\+.*TRUNCATE" | grep -v "^.*--.*TRUNCATE" && echo "$file"
  done | grep -q .; then
    echo -e "${RED}🚨 警告: 檢測到 TRUNCATE 指令！${NC}"
    echo "這會清空資料表，請確認是否需要此操作。"
    echo "📖 參考: docs/SAFE_MIGRATION_GUIDE.md"
    echo ""
    read -p "確定要繼續提交嗎？(y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo -e "${YELLOW}⏸️ 已取消提交${NC}"
      exit 1
    fi
  fi

  echo -e "${GREEN}✅ Migration 安全檢查通過${NC}"
fi

# 檢查 2: 腳本中的 db reset 指令（排除 Markdown 文件）
if git diff --cached --name-only | grep -qE "\.(sh|js|ts)$"; then
  if git diff --cached --name-only | grep -E "\.(sh|js|ts)$" | while read file; do
    if git diff --cached "$file" | grep -E "^\+.*supabase db reset" | grep -v "^.*#.*db reset"; then
      echo -e "${RED}🚨 警告: 檢測到 'supabase db reset' 指令！${NC}"
      echo "檔案: $file"
      echo "請確認此指令僅用於本機環境。"
      echo "⚡ 參考: docs/DATABASE_SAFETY_PROTOCOL.md"
      echo ""
      read -p "確定要繼續提交嗎？(y/n) " -n 1 -r </dev/tty
      echo
      if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}⏸️ 已取消提交${NC}"
        exit 1
      fi
    fi
  done; then
    if [ $? -eq 1 ]; then
      exit 1
    fi
  fi
fi

# 檢查 3: ESLint 檢查（僅檢查已暫存的檔案）
echo "🔍 執行 ESLint 檢查..."
if git diff --cached --name-only | grep -qE "\.(ts|tsx|js|jsx)$"; then
  staged_files=$(git diff --cached --name-only --diff-filter=d | grep -E "\.(ts|tsx|js|jsx)$" | xargs)
  if [ -n "$staged_files" ]; then
    echo "檢查檔案: $staged_files"
    # ESLint v9 使用舊配置格式需加上 --config 標誌
    if ! ESLINT_USE_FLAT_CONFIG=false npx eslint $staged_files --max-warnings=0; then
      echo -e "${RED}❌ ESLint 檢查失敗${NC}"
      echo "請修復上述錯誤後再提交"
      exit 1
    fi
    echo -e "${GREEN}✅ ESLint 檢查通過${NC}"
  fi
fi

echo -e "${GREEN}✅ 所有安全檢查通過${NC}"
exit 0
