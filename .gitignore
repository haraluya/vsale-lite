# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.vercel

# GCS Service Account 金鑰（絕對不要上傳到 Git！）
service-account-key.json
*-service-account-key.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vitest
.vitest

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
node_modules

# ========================================
# Temporary Test & Debug Files (根目錄)
# ========================================
# SQL 臨時檔案（診斷、修復、測試）
check-*.sql
diagnose-*.sql
fix-*.sql
setup-*.sql
setup-test-*.sql
create-admin*.sql
insert-*.sql
insert-test-*.sql

# JS 測試檔案
test-*.js

# ========================================
# Archive Directories (歸檔目錄)
# ========================================
# 排除歷史備份檔案
backups/archive/

# 排除資料庫工具腳本（敏感操作）
scripts/db/*.sql

# 排除已完成的計畫文件
docs/archive/planning/

# 排除過時的部署文件
docs/archive/deployment/

# 環境檢查檔案
.env.*.check

# ========================================
# Temporary Documentation (根目錄)
# ========================================
# 修復記錄
FIX_*.md
QUICK_*.md
URGENT_*.md
SIMPLE_*.md
VERCEL_*.md
DEBUG-*.md

# 研究報告（應放在 docs/ 或 specs/）
RESEARCH_*.md
RLS_RESEARCH_*.md
*_RESEARCH_*.md
VIEWS_RESEARCH.md
SUPABASE_RLS_*.md

# 除錯記錄
dialog.md

# 決策記錄（應放在 docs/）
DECISION_*.md

# 過時文件
MIGRATION_REQUIRED.md
LOCAL_SUPABASE_SETUP.md

# 臨時報告檔案
RESEARCH_*.txt

# Firebase (不使用)
.firebaserc
firebase.json
.firebaseignore
apphosting.yaml
firebase-debug.log
.env.production

# Backup Files
*.backup
*.bak

# Test Files (專案不使用測試，僅在 node_modules)
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__/

# Documentation & Specs (不需要部署)
/docs/
/specs/
*.md
!README.md
!CLAUDE.md
!DEPLOYMENT.md

# 但健康檢查規格需要追蹤
!/specs/017-health-check/

# 可移植性修復規格需要追蹤
!/specs/019-portability-fixes/

# Health Check Reports (排除時間戳目錄，保留 latest 符號連結)
specs/017-health-check/reports/20*
!specs/017-health-check/reports/latest

# Supabase Local
supabase/snippets/
supabase/.temp/

# Database Backups (敏感資料，不應 commit)
backups/*.sql
backups/*.dump
backups/*.tar.gz
backups/*.json
!backups/README.md
!backups/check_db_stats.js
!backups/DISASTER_RECOVERY_TEST_REPORT.md
!backups/restore_from_backup.js

# Backup files in root directory (generated during testing)
vsale-backup-*.sql
vsale-backup-*.sql.gz
vsale-backup-*.zip
backup-*.sql
*.sql.backup

# Scripts (不需要部署)
/scripts/
# 但健康檢查腳本需要追蹤
!/scripts/health-check/

# Claude Code
.claude/

# GitHub Workflows (需手動透過 GitHub 網頁建立)
.github/workflows/
# 忽略包含敏感資訊的文件
docs/SITE_CREDENTIALS.md
